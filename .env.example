# Credenciales SMTP para las alertas por email. Copiar a `.env` en la raíz del
# repo EN EL SERVIDOR y rellenar. El `.env` está gitignored: nunca se commitea.
# Lo leen seo/notify.py (cron generate_site) y scripts/healthcheck.py.

# Servidor SMTP. Por defecto Gmail (Google→Google entrega fiable a la propia
# cuenta). 465 = SSL implícito; 587 = STARTTLS (el código lo detecta por el puerto).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465

# AUTENTICACIÓN. Con Gmail: la dirección @gmail.com y una "Contraseña de
# aplicación" (Cuenta de Google → Seguridad → Verificación en dos pasos →
# Contraseñas de aplicaciones), NO la contraseña normal. Se muestra en 4 grupos
# de 4 con espacios; pégala SIN espacios (16 caracteres seguidos).
SMTP_USER=tu-cuenta@gmail.com
SMTP_PASS=pon-aqui-la-app-password-sin-espacios

# REMITENTE visible (header From). Con Gmail debe coincidir con SMTP_USER (o un
# alias verificado como "Enviar como"). Si se deja vacío, se usa SMTP_USER.
ALERT_FROM=tu-cuenta@gmail.com

# Destinatario de las alertas.
ALERT_TO=destinatario@example.com
