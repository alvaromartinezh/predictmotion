# Credenciales SMTP para las alertas por email. Copiar a `.env` en la raíz del
# repo EN EL SERVIDOR y rellenar. El `.env` está gitignored: nunca se commitea.
# Lo leen seo/notify.py (cron generate_site) y scripts/healthcheck.py.

# Servidor SMTP. Por defecto Gmail (Google→Google entrega fiable a la propia
# cuenta). 465 = SSL implícito; 587 = STARTTLS (el código lo detecta por el puerto).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465

# AUTENTICACIÓN. Con Gmail: la dirección @gmail.com y una "Contraseña de
# aplicación" (Cuenta de Google → Seguridad → Verificación en dos pasos →
# Contraseñas de aplicaciones), NO la contraseña normal. Se muestra en 4 grupos
# de 4 con espacios; pégala SIN espacios (16 caracteres seguidos).
SMTP_USER=tu-cuenta@gmail.com
SMTP_PASS=pon-aqui-la-app-password-sin-espacios

# REMITENTE visible (header From). Con Gmail debe coincidir con SMTP_USER (o un
# alias verificado como "Enviar como"). Si se deja vacío, se usa SMTP_USER.
ALERT_FROM=tu-cuenta@gmail.com

# Destinatario de las alertas.
ALERT_TO=destinatario@example.com


# ── Cuentas de usuario (servicio accounts/, login con Google) ─────────────────
# Interruptor de la feature. En CP0 se despliega a oscuras (false). En CP1 se
# pone a true para que funcionen /api/auth/* y /api/me.
ACCOUNTS_ENABLED=false

# Client ID de OAuth de Google (tipo "Aplicación web"). Es PÚBLICO (va también en
# el JS del frontend); no es un secreto. NO hace falta el client_secret: el flujo
# de identidad usa solo el Client ID + verificación local de la firma del token.
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com

# Cookie de sesión Secure (solo se manda por HTTPS). true en producción; en dev
# local sobre http se pone a false (start.py --accounts ya lo hace).
# ACCOUNTS_COOKIE_SECURE=true


# ── Backups de la DB de usuarios (scripts/backup_db.py, cron diario) ──────────
# Passphrase AES para cifrar el dump. IMPRESCINDIBLE y ⚠️ GUÁRDALA TAMBIÉN FUERA
# DEL SERVIDOR (gestor de contraseñas): sin ella los backups off-site no se pueden
# descifrar. Genera una larga y aleatoria. Ver docs/backups.md.
BACKUP_PASSPHRASE=pon-aqui-una-passphrase-larga-y-aleatoria
# Clon del repo privado de backups (deploy key dedicada). Def: /home/ubuntu/predictmotion-backups
# BACKUP_REPO_DIR=/home/ubuntu/predictmotion-backups
# Nº de snapshots a conservar (local y en el repo). Def: 14
# BACKUP_KEEP=14
# Día del email de respaldo: 0=lunes … 6=domingo; -1 = cada ejecución; vacío = off. Def: 0
# BACKUP_EMAIL_WEEKDAY=0


# ── Broadsheet diario de Hypermotion (articles/generate.py, cron a las 23:59) ─
# API key de Gemini (aistudio.google.com/apikey). Usa gemini-3.5-flash-lite
# (ver articles/config.py). Sin ella, articles/gemini_client.py lanza y el
# cron manda una alerta por email best-effort (no rompe nada más).
GEMINI_API_KEY=pon-aqui-la-api-key-de-gemini

# Bot de Telegram (@BotFather) — lo comparten seo/tweets.py (tuits de jornada)
# y articles/generate.py (aviso de titular+enlace al publicar el broadsheet).
# TELEGRAM_CHAT_ID también se aprende solo con /start si se deja vacío aquí,
# pero fijarlo evita depender de que alguien lo arranque a mano una vez.
TELEGRAM_BOT_TOKEN=pon-aqui-el-token-del-bot
TELEGRAM_CHAT_ID=pon-aqui-el-chat-id
