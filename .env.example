# Credenciales SMTP para las alertas por email (Zoho). Copiar a `.env` en la
# raíz del repo EN EL SERVIDOR y rellenar. El `.env` está gitignored: nunca se
# commitea. Lo leen seo/notify.py (cron generate_site) y scripts/healthcheck.py.

# Host SMTP de Zoho según la región de la cuenta: smtp.zoho.eu (Europa) o
# smtp.zoho.com (global).
ZOHO_SMTP_HOST=smtp.zoho.eu
# Puerto 465 = SSL implícito. Si diera 535 / fallo de handshake, probar 587
# (el código usa STARTTLS automáticamente cuando el puerto es 587).
ZOHO_SMTP_PORT=465

# AUTENTICACIÓN SMTP: la CUENTA REAL de Zoho (el único usuario de la
# organización), NO un alias. Un alias como contact@predictmotion.com no es una
# cuenta con login propio y da error 535. La app password se genera en esta
# cuenta (Zoho → Seguridad → Contraseñas de aplicación), no es la del login web.
ZOHO_SMTP_USER=contact@predictmotion.com
ZOHO_SMTP_PASS=pon-aqui-la-app-password

# REMITENTE VISIBLE (header From): puede ser un alias de la cuenta de arriba
# (debe estar verificado en Zoho como "Send Mail As"). Se separa a propósito del
# usuario de login. Si se deja vacío, se envía desde ZOHO_SMTP_USER.
ALERT_FROM=contact@predictmotion.com

# Destinatario de las alertas.
ALERT_TO=contact@predictmotion.com
