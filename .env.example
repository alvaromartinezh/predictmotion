# Credenciales SMTP para las alertas por email (Zoho). Copiar a `.env` en la
# raíz del repo EN EL SERVIDOR y rellenar. El `.env` está gitignored: nunca se
# commitea. Lo leen seo/notify.py (cron generate_site) y scripts/healthcheck.py.

# Host SMTP de Zoho según la región de la cuenta: smtp.zoho.eu (Europa) o
# smtp.zoho.com (global).
ZOHO_SMTP_HOST=smtp.zoho.eu
# 465 = SSL implícito. Si diera 535/handshake, probar 587 (el código usa
# STARTTLS automáticamente cuando el puerto es 587).
ZOHO_SMTP_PORT=465

# AUTENTICACIÓN SMTP: el BUZÓN REAL de Zoho (p. ej. tu-buzon@zohomail.eu).
# OJO: NO es el email de login del panel de Zoho si ese es un correo externo
# (gmail, etc.) — ese no es una identidad SMTP y da error 553 "Sender is not
# allowed to relay". La contraseña es una app password generada en la cuenta
# (Zoho → Seguridad → Contraseñas de aplicación), no la del login web.
ZOHO_SMTP_USER=tu-buzon@zohomail.eu
ZOHO_SMTP_PASS=pon-aqui-la-app-password

# REMITENTE visible (header From). En un plan de Zoho SIN dominio propio
# verificado debe COINCIDIR con ZOHO_SMTP_USER (no se puede enviar "as" un
# alias/gmail arbitrario → 553). Con dominio propio + alias verificado como
# "Send Mail As", aquí puede ir el alias. Si se deja vacío, se usa ZOHO_SMTP_USER.
ALERT_FROM=tu-buzon@zohomail.eu

# Destinatario de las alertas.
ALERT_TO=destinatario@example.com
